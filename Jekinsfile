pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Pulling the main branch from GitHub...'
                // Explicitly targeting the 'main' branch so it does not fail
                git branch: 'main', url: 'https://github.com'
            }
        }

        stage('Build') {
            steps {
                echo 'Running Python Application with 10 and 20 input feeds...'
                // Using 'bat' for your Windows machine to pipe the inputs
                bat 'echo 10 && echo 20 | python app.py'
            }
        }
    }
}
