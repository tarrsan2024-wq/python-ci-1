pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com'
            }
        }

        stage('Build') {
            steps {
                echo 'Feeding inputs 10 and 20 into app.py...'
                bat 'echo 10 && echo 20 | python app.py'
            }
        }
    }
}
